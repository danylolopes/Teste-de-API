  "item": [
    {
      "name": "POST - Create Admin User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Admin criado\", () => {\r",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
              "});\r",
              "\r",
              "const json = pm.response.json();\r",
              "pm.environment.set(\"adminEmail\", pm.request.body.raw.match(/\"email\":\\s*\"([^\"]+)\"/)[1]);\r",
              "pm.environment.set(\"adminPassword\", \"123456\");\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nome\": \"Admin Teste\",\r\n  \"email\": \"admin{{$randomInt}}@teste.com\",\r\n  \"password\": \"123456\",\r\n  \"administrador\": \"true\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
